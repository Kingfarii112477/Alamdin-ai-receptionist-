# ---------------------------------------------------------------------------
# Alamdin AI Receptionist — environment configuration
# Copy this file to .env and adjust values. Never commit a real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# Database (Prisma). Default is SQLite — zero setup required.
# For production, switch prisma/schema.prisma datasource provider to
# "postgresql" and set DATABASE_URL to a real Postgres connection string,
# e.g. postgresql://user:password@host:5432/alamdin_receptionist
DATABASE_URL="file:./dev.db"

# --- AI provider abstraction -------------------------------------------------
# AI_PROVIDER is auto-selected: if AI_API_KEY is set, "openai-compatible" is
# used; otherwise the app falls back to the built-in "template" provider
# (rule-based, no external calls, always works offline/CI).
# Works with OpenAI, OpenRouter, or any OpenAI-compatible /chat/completions
# endpoint (e.g. Gemini via an OpenAI-compatible proxy).
AI_PROVIDER=template
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Optional. Some providers (e.g. Gemini's reasoning models) spend part of
# the token budget on hidden "thinking" before the visible reply, which can
# truncate short receptionist responses. Set to "minimal" for Gemini via
# https://generativelanguage.googleapis.com/v1beta/openai (model:
# gemini-3.6-flash or similar) — "none" is rejected by Gemini's API as an
# invalid value, "minimal" effectively disables thinking. Leave unset for
# plain OpenAI.
AI_REASONING_EFFORT=

# CORS — comma-free single origin, or "*" for the test web UI.
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Admin dashboard API key — required in the X-Admin-Key header for
# /api/v1/appointments (list) and the /admin web UI.
ADMIN_API_KEY=change-me-admin-key

LOG_LEVEL=info
