// Alamdin AI Receptionist — PRODUCTION database schema (PostgreSQL)
//
// Identical models to prisma/schema.prisma (the SQLite dev schema) — only
// the datasource provider differs. Used for cloud deployments where the
// host has no persistent local disk (e.g. Render's free web service), so
// SQLite's on-disk file can't survive restarts/redeploys and a real
// Postgres database is required instead.
//
// Local development is untouched: `npm run dev` / `npm test` keep using
// prisma/schema.prisma (SQLite) as before. This file lives in its own
// directory (rather than next to schema.prisma) because Prisma resolves a
// schema's migrations folder as "<schema's directory>/migrations" with no
// way to override it — two schemas sharing prisma/ would collide on the
// same prisma/migrations folder. This file is only referenced by the
// deployment scripts (see package.json "render-build"/"render-start" and
// render.yaml) via `--schema=prisma/production/schema.prisma`.
//
// See README.md → "Deploying to Render (free tier) with Neon Postgres".

generator client {
  provider      = "prisma-client-js"
  // Explicit (not "native") because this schema's `prisma generate` may run
  // on a build machine whose OS differs from Netlify's Lambda runtime
  // (Amazon Linux). Pinning both OpenSSL ABIs covers Node 18 and Node 20+
  // function runtimes regardless of where the client was generated.
  binaryTargets = ["rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// One chat session with a single patient, across one channel (web today,
/// WhatsApp/voice later). Holds both the running appointment-collection
/// state and the free-form conversation history.
model Conversation {
  id        String   @id @default(cuid())
  channel   String   @default("web") // web | whatsapp (future) | voice (future)

  /// Detected language of the most recent patient message.
  language  String   @default("english") // english | urdu | roman-urdu

  /// Appointment intake state machine stage. See src/types/conversation.ts.
  stage     String   @default("IDLE")

  /// Fields collected one-at-a-time during an appointment request.
  patientName     String?
  phone           String?
  reason          String?
  preferredDateRaw   String?
  preferredDateISO   String?
  preferredTimeRaw   String?
  preferredTimeNormalized String?

  /// NOT_APPLICABLE | PENDING | REQUESTED — mirrors AppointmentRequest.status
  /// for the *current* in-flight request only.
  confirmationStatus String @default("NOT_APPLICABLE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages             Message[]
  appointmentRequests  AppointmentRequest[]

  @@index([updatedAt])
}

/// Full transcript, stored for audit/debugging and future analytics.
model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role      String   // user | assistant | system
  content   String

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

/// A patient-submitted appointment REQUEST. This is explicitly not a
/// confirmed appointment — clinic staff confirm availability by phone.
model AppointmentRequest {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  patientName String
  phone       String
  reason      String

  preferredDateRaw String
  preferredDateISO String
  preferredTimeRaw String
  preferredTimeNormalized String

  /// NEW | PENDING_CONFIRMATION | CONFIRMED_BY_CLINIC | CANCELLED | COMPLETED
  /// The AI engine only ever writes NEW. Every other transition is a manual
  /// staff action via POST /api/v1/appointments/:id/status.
  status String @default("NEW")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Future extension points (deliberately NOT modeled yet, per project scope):
//
//   Patient      — a durable identity across conversations/channels
//   Doctor       — multi-doctor support beyond Dr. Alamdin
//   Clinic       — multi-location support
//   Availability — real bookable time slots (would replace "requests" with
//                  true confirmed Appointment scheduling)
//   Appointment  — a confirmed, slot-backed booking distinct from a request
//   Lead         — pre-appointment marketing/intake funnel tracking
//   FollowUp     — post-visit follow-up / recall reminders
//
// AppointmentRequest.conversationId and the Conversation model are shaped so
// these can be layered on later (e.g. AppointmentRequest gaining an optional
// patientId, or a status transition into a real Appointment row) without a
// breaking rewrite of the receptionist engine.
// ---------------------------------------------------------------------------
