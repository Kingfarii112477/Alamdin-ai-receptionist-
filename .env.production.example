# ---------------------------------------------------------------------------
# Skin Center AI Receptionist — PRODUCTION environment reference
#
# This documents the env vars used when deploying with prisma/production/
# (PostgreSQL). It is not read automatically by the app — set these as real
# environment variables in your hosting platform's dashboard (e.g. Render's
# "Environment" tab), not as a committed file.
#
# Local development is unaffected: keep using .env / .env.example (SQLite).
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3000

# PostgreSQL connection string (e.g. from Neon, neon.tech — free, no
# expiration, no credit card). Include ?sslmode=require if your provider
# requires TLS (Neon does).
DATABASE_URL="postgresql://user:password@host:5432/skin_center_receptionist?sslmode=require"

# --- AI provider abstraction -------------------------------------------------
# Leave AI_API_KEY blank to run fully offline on the built-in template
# provider (zero cost, zero external calls). Set it to upgrade FAQ/small-talk
# replies to a real LLM via any OpenAI-compatible endpoint.
AI_PROVIDER=template
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Set to your deployed origin(s) once you have a fixed URL, e.g.
# https://skin-center-ai-receptionist.onrender.com
CORS_ORIGIN=*

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# REQUIRED: set a strong, unique secret before going live — protects the
# admin dashboard and GET/POST /api/v1/appointments* endpoints.
ADMIN_API_KEY=replace-with-a-strong-random-secret

LOG_LEVEL=info

# --- WhatsApp Business Cloud API (optional) ----------------------------------
# Leave all four blank to run without WhatsApp — nothing else changes. See
# README.md → "WhatsApp integration" for the full Meta setup walkthrough.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
