{
  "name": "alamdin-ai-receptionist",
  "version": "1.0.0",
  "description": "Portable AI receptionist backend for Skin Center — Dr. Syed Bilal Shams, Quetta",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "pretest": "DATABASE_URL=file:./test.db npx prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate",
    "prisma:generate:prod": "prisma generate --schema=prisma/production/schema.prisma",
    "prisma:deploy:prod": "prisma migrate deploy --schema=prisma/production/schema.prisma",
    "prisma:studio:prod": "prisma studio --schema=prisma/production/schema.prisma",
    "render-build": "npm install && npm run prisma:generate:prod && npm run build",
    "render-start": "npm run prisma:deploy:prod && npm start",
    "vercel-build": "npm run prisma:generate:prod && npm run prisma:deploy:prod"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "pino-pretty": "^11.2.2",
    "serverless-http": "^4.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@netlify/functions": "^5.3.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.19.1",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
